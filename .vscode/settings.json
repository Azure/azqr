{
    // Go Language Server (gopls) settings
    "gopls": {
        // Add integration build tag so gopls can analyze integration test files
        "build.buildFlags": [
            "-tags=integration"
        ],
        // Enable build tags in the environment
        "env": {
            "GOFLAGS": "-tags=integration"
        }
    },
    // Go test settings
    "go.testTags": "integration",
    "go.buildTags": "integration",
    // Editor settings for Go files
    "[go]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#344F6B",
        "titleBar.activeForeground": "#FFFFFF",
        "activityBar.background": "#344F6B",
        "activityBar.foreground": "#FFFFFF",
        "statusBar.background": "#344F6B",
        "statusBar.foreground": "#FFFFFF",
        "window.activeBorder": "#344F6B",
        "window.inactiveBorder": "#344F6B",
        "editorGroup.border": "#344F6B"
    }
}